# ==============================================================
# CARDOSO AI — Configuration Environment Variables
# ==============================================================
# Local: copy to .env  |  Render: set these in the Dashboard → Environment

# Node Environment ('development' or 'production')
NODE_ENV=development

# Password for the No-Code Bot Studio web dashboard (required to open it)
STUDIO_PASSWORD=change_me_to_a_strong_password

# Max broadcast messages allowed per 24 hours (0 = unlimited)
BROADCAST_DAILY_LIMIT=0

# --------------------------------------------------------------
# 1. Google Gemini AI Configuration (Free Tier)
# --------------------------------------------------------------
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended free model on Render:
GEMINI_MODEL=gemini-2.5-flash

# Maximum requests per day to protect your free tier (Free quota is ~1,500 RPD)
# Setting to 1400 leaves a safe buffer to ensure ZERO accidental charges.
DAILY_REQUEST_LIMIT=1400

# Per-minute rate limit (Free tier is 15 RPM)
REQUESTS_PER_MINUTE_LIMIT=14

# --------------------------------------------------------------
# 2. Local llama.cpp / Ollama Fallback (Optional)
# --------------------------------------------------------------
# Leave empty or set to false to disable local fallback.
ENABLE_LOCAL_FALLBACK=false
LOCAL_FALLBACK_URL=http://127.0.0.1:8080/v1
LOCAL_FALLBACK_MODEL=llama-3.2-3b

# --------------------------------------------------------------
# 3. Messaging Transport Settings
# --------------------------------------------------------------
# Available modes: 'console' (for local testing), 'baileys' (WhatsApp Web), 'webhook' (Meta Cloud API)
# Render production: set MESSAGING_MODE=baileys
MESSAGING_MODE=console

# Group activation mode:
# - 'mention_only': Bot only responds when tagged or when message starts with !cardoso
# - 'all': Bot responds to all messages (NOT recommended for groups)
GROUP_RESPONSE_MODE=mention_only

# Command trigger prefix for student & admin commands
BOT_PREFIX=!cardoso

# --------------------------------------------------------------
# 4. WhatsApp / Admin Permissions
# --------------------------------------------------------------
# Comma-separated WhatsApp numbers (with country code, no + or spaces)
ADMIN_PHONE_NUMBERS=252610000000

# Comma-separated allowed WhatsApp group JIDs (leave empty to allow all groups where bot is added)
ALLOWED_GROUPS=

# --------------------------------------------------------------
# 5. Data Privacy & Retention
# --------------------------------------------------------------
# Path to local SQLite database
DATABASE_PATH=./data/abarso.db

# How many days of conversation history to keep before automatic purge
DATA_RETENTION_DAYS=30

# Max conversation history messages to pass to Gemini per turn (saves tokens)
MAX_CONTEXT_MESSAGES=10

# --------------------------------------------------------------
# 6. Webhook Server & Admin Dashboard Port
# --------------------------------------------------------------
PORT=3000
WEBHOOK_VERIFY_TOKEN=cardoso_secret_verify_token_change_me

# --------------------------------------------------------------
# 7. Render (optional — set in Render Dashboard)
# --------------------------------------------------------------
# SESSION_CREDS_BASE64=   # npm run export-session → paste base64 here
# RENDER_EXTERNAL_URL=    # e.g. https://cardoso-ai-bot.onrender.com

